# ==========================================
# Unity General .gitignore
# Works for root projects and subprojects (e.g., Ember000/)
# ==========================================

# Unity generated / temporary folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Explicit casing for common folders
UserSettings/
Library/
Temp/
Obj/
Build/
Builds/
Logs/

# Asset Store Tools & Cache
[Aa]ssets/AssetStoreTools*
**/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Pp]lugins/Editor/JetBrains*
**/[Aa]ssets/[Pp]lugins/Editor/JetBrains*

# Autogenerated IDE / Solution Files
ExportedObj/
**/ExportedObj/
.consulo/
**/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler / code coverage output
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Unity crash reports
crashlytics-build.properties

# Visual Studio / Rider / JetBrains / VS Code
.vs/
**/.vs/
.idea/
**/.idea/
.vscode/
**/.vscode/
*.private
*.private.meta
^*.private.meta

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Builds / Standalone executables
*.exe
*.dll
*.so
*.dylib
# Uncomment below if you have pre-compiled managed DLL plugins in Assets/Plugins that you DO want to track:
# !Assets/**/Plugins/**/*.dll
